# Kopieren nach .env und anpassen:  cp .env.example .env
# docker compose liest .env automatisch.

# Gemeinsamer WG-Zugangscode (bitte ändern!).
ACCESS_CODE=wg-casting

# Die 5 Mitbewohner:innen, kommagetrennt (echte Vornamen).
FLATMATES=Anna,Ben,Cem,Dana,Eli

# Default-Gemini-Modell. Der API-Key wird NICHT hier gesetzt, sondern
# in der App unter „KI-Einstellungen“ eingegeben.
GEMINI_MODEL=gemini-flash-latest
